## Rodar a série temporal
datas <- seq.Date(
from = as.Date('2022-01-01'),
to   = as.Date('2024-12-01'),
by   = 'month'
) |> as.character()
resultados <- vector("list", length(datas))
resultados <- vector("list", length(datas))
for (t in seq_along(datas)) {
print(
paste(
'Obtendo série para',
datas[t]
)
)
resultados[t] <- list(
tryCatch(
retornar_serie(as.character(datas[t])),
error = function(e) NULL
)
)
Sys.sleep(2)
}
saveRDS(resultados, file.path(dir_path, 'dados', 'resultados_2022-01-01_2024-12-01.rds'))
