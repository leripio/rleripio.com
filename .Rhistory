## Resultados
resultados <- list.files(
path = file.path(dir_path, 'dados'),
pattern = '.rds',
full.names = TRUE
) |>
map(
.f = \(x) readRDS(x)
) |>
reduce(c)
## Gerar plot
resultados_tidy <- resultados |>
map_dfr(
.f = \(x) x |>
select(data, produto, ano_mod, cd_modelo, cd_fipe, valor_num) |>
unnest(cd_fipe)
) |>
mutate(ano_ref = year(data)) |>
group_by(cd_fipe) |>
arrange(data) |>
mutate(variacao = 100 * ((valor_num / dplyr::lag(valor_num)) - 1)) |>
ungroup()
resultados_mensais <- resultados_tidy |>
mutate(
ano_ref = year(data),
mes = month(data)
) |>
filter(
!is.na(variacao),
variacao > -100
) |>
group_by(ano_ref, mes) |>
summarise(
media_geometrica = 100 * (
exp(mean(log1p(variacao / 100))) - 1
),
limite_inferior = quantile(
variacao,
probs = 0.25,
na.rm = TRUE
),
limite_superior = quantile(
variacao,
probs = 0.75,
na.rm = TRUE
),
.groups = "drop"
)
rotulos_anos <- resultados_mensais |>
group_by(ano_ref) |>
slice_max(mes, n = 1, with_ties = FALSE) |>
ungroup()
resultados_mensais |>
filter(mes != 1) |>
ggplot(
aes(
x = mes,
group = factor(ano_ref),
color = factor(ano_ref),
fill = factor(ano_ref)
)
) +
guides(color = 'none', fill = 'none') +
geom_ribbon(
aes(
ymin = limite_inferior,
ymax = limite_superior
),
alpha = 0.12,
color = NA
) +
geom_line(
aes(y = media_geometrica),
linewidth = 1
) +
geom_point(
aes(y = media_geometrica),
size = 1.5
) +
scale_x_continuous(
breaks = 1:12,
labels = month.abb
) +
geom_text_repel(
data = rotulos_anos,
aes(
x = mes + 0.15,
y = media_geometrica,
label = ano_ref
),
direction = "y",
hjust = 1.2,
size = 3.5,
segment.color = NA,
show.legend = FALSE
) +
scale_x_continuous(
breaks = 1:12,
